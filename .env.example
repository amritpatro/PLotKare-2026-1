NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-server-only
# Dev on port 3002 — keep in sync with Supabase Auth → URL Configuration:
#   Site URL:      http://127.0.0.1:3002
#   Redirect URLs: http://127.0.0.1:3002/auth/callback**
# Google OAuth also requires its provider to be enabled in Supabase and the
# Supabase callback URL to be registered in Google Cloud:
#   https://<project-ref>.supabase.co/auth/v1/callback
# Supabase Auth redirect allow list should include:
#   http://127.0.0.1:3002/auth/callback**
#   https://<vercel-production-host>/auth/callback**
#   https://plotkare.in/auth/callback**
#   https://www.plotkare.in/auth/callback**
# Run: npm run dev  → http://127.0.0.1:3002
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3002
# SEO canonical base. Keep this on the final public domain, not localhost or preview.
NEXT_PUBLIC_CANONICAL_SITE_URL=https://plotkare.in
NEXT_PUBLIC_LEGAL_BUSINESS_NAME=
NEXT_PUBLIC_GENERAL_EMAIL=
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_OFFICE_ADDRESS_LINE_1=
NEXT_PUBLIC_OFFICE_ADDRESS_LINE_2=
NEXT_PUBLIC_SUPPORT_HOURS=

# If signup returns 500 "Error sending confirmation email", fix Supabase SMTP (Auth → Email) or temporarily:
# Auth → Providers → Email → disable "Confirm email" for local dev only (re-enable before production).

# Online payment activation is intentionally deferred.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_BASIC_ID=
RAZORPAY_PLAN_STANDARD_ID=
RAZORPAY_PLAN_PREMIUM_ID=

RESEND_API_KEY=re_xxxxxxxxxxxxxx
RESEND_FROM_EMAIL=
SUPPORT_EMAIL=

NEXT_PUBLIC_POSTHOG_KEY=phc_xxxxxxxxxxxxxx
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
POSTHOG_PROJECT_API_KEY=phx_xxxxxxxxxxxxxx
SENTRY_DSN=https://example@sentry.io/project
NEXT_PUBLIC_SENTRY_DSN=https://example@sentry.io/project
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token
CRON_SECRET=replace-with-a-random-server-only-secret
# Optional. Leave blank until a staffed WhatsApp number is ready.
NEXT_PUBLIC_WHATSAPP_URL=
