# PlotKare Production Environment Variables
# Copy this to Vercel dashboard under Settings > Environment Variables
# Never put real values in this file

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-server-only

# Site URL (must match your actual domain)
NEXT_PUBLIC_SITE_URL=https://plotkare.in

# Email via Resend
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=hello@plotkare.in
SUPPORT_EMAIL=hello@plotkare.in

# Rate limiting via Upstash Redis
UPSTASH_REDIS_REST_URL=https://your-upstash-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# Error monitoring
NEXT_PUBLIC_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# Cron job authentication
CRON_SECRET=random-32-character-string-here

# Payments (deferred - keep placeholder)
RAZORPAY_KEY_ID=rzp_live_your_key
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# PostHog analytics
NEXT_PUBLIC_POSTHOG_KEY=phc_your_posthog_key
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
